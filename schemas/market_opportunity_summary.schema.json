{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Globiq Market Opportunity Summary",
  "type": "object",
  "required": [
    "metadata",
    "universe",
    "products",
    "markets"
  ],
  "properties": {
    "metadata": {
      "$ref": "#/$defs/metadata"
    },
    "universe": {
      "type": "object",
      "required": [
        "gross_combinations",
        "same_market_exclusions",
        "external_relationships",
        "category_counts",
        "percentage_denominator",
        "category_percentages"
      ],
      "properties": {
        "gross_combinations": {
          "$ref": "#/$defs/count"
        },
        "same_market_exclusions": {
          "$ref": "#/$defs/count"
        },
        "external_relationships": {
          "$ref": "#/$defs/count"
        },
        "category_counts": {
          "type": "object",
          "required": [
            "A",
            "B",
            "C"
          ],
          "properties": {
            "A": {
              "$ref": "#/$defs/count"
            },
            "B": {
              "$ref": "#/$defs/count"
            },
            "C": {
              "$ref": "#/$defs/count"
            }
          },
          "additionalProperties": false
        },
        "percentage_denominator": {
          "const": "All external relationships"
        },
        "category_percentages": {
          "type": "object",
          "required": [
            "A",
            "B",
            "C"
          ],
          "properties": {
            "A": {
              "type": [
                "null",
                "number"
              ],
              "minimum": 0,
              "maximum": 100
            },
            "B": {
              "type": [
                "null",
                "number"
              ],
              "minimum": 0,
              "maximum": 100
            },
            "C": {
              "type": [
                "null",
                "number"
              ],
              "minimum": 0,
              "maximum": 100
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "products": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "product_code",
          "description",
          "reference_mapped",
          "observed_exporters",
          "observed_importers",
          "gross_combinations",
          "same_market_exclusions",
          "external_relationships",
          "category_counts"
        ],
        "properties": {
          "product_code": {
            "$ref": "#/$defs/product"
          },
          "description": {
            "type": [
              "string",
              "null"
            ]
          },
          "reference_mapped": {
            "const": true
          },
          "observed_exporters": {
            "$ref": "#/$defs/positive"
          },
          "observed_importers": {
            "$ref": "#/$defs/positive"
          },
          "gross_combinations": {
            "$ref": "#/$defs/count"
          },
          "same_market_exclusions": {
            "$ref": "#/$defs/count"
          },
          "external_relationships": {
            "$ref": "#/$defs/count"
          },
          "category_counts": {
            "type": "object",
            "required": [
              "A",
              "B",
              "C"
            ],
            "properties": {
              "A": {
                "$ref": "#/$defs/count"
              },
              "B": {
                "$ref": "#/$defs/count"
              },
              "C": {
                "$ref": "#/$defs/count"
              }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    },
    "markets": {
      "type": "object",
      "required": [
        "exporter",
        "importer"
      ],
      "properties": {
        "exporter": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "market",
              "role",
              "observed_product_diversity",
              "gross_combinations",
              "same_market_exclusions",
              "external_relationships",
              "category_counts"
            ],
            "properties": {
              "market": {
                "$ref": "#/$defs/market"
              },
              "role": {
                "const": "exporter"
              },
              "observed_product_diversity": {
                "$ref": "#/$defs/positive"
              },
              "gross_combinations": {
                "$ref": "#/$defs/count"
              },
              "same_market_exclusions": {
                "$ref": "#/$defs/count"
              },
              "external_relationships": {
                "$ref": "#/$defs/count"
              },
              "category_counts": {
                "type": "object",
                "required": [
                  "A",
                  "B",
                  "C"
                ],
                "properties": {
                  "A": {
                    "$ref": "#/$defs/count"
                  },
                  "B": {
                    "$ref": "#/$defs/count"
                  },
                  "C": {
                    "$ref": "#/$defs/count"
                  }
                },
                "additionalProperties": false
              }
            },
            "additionalProperties": false
          }
        },
        "importer": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "market",
              "role",
              "observed_product_diversity",
              "gross_combinations",
              "same_market_exclusions",
              "external_relationships",
              "category_counts"
            ],
            "properties": {
              "market": {
                "$ref": "#/$defs/market"
              },
              "role": {
                "const": "importer"
              },
              "observed_product_diversity": {
                "$ref": "#/$defs/positive"
              },
              "gross_combinations": {
                "$ref": "#/$defs/count"
              },
              "same_market_exclusions": {
                "$ref": "#/$defs/count"
              },
              "external_relationships": {
                "$ref": "#/$defs/count"
              },
              "category_counts": {
                "type": "object",
                "required": [
                  "A",
                  "B",
                  "C"
                ],
                "properties": {
                  "A": {
                    "$ref": "#/$defs/count"
                  },
                  "B": {
                    "$ref": "#/$defs/count"
                  },
                  "C": {
                    "$ref": "#/$defs/count"
                  }
                },
                "additionalProperties": false
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "$defs": {
    "count": {
      "type": "integer",
      "minimum": 0
    },
    "positive": {
      "type": "integer",
      "minimum": 1
    },
    "product": {
      "type": "string",
      "pattern": "^([0-9]{6}|9999AA)$"
    },
    "version": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "category": {
      "enum": [
        "A",
        "B",
        "C"
      ]
    },
    "market": {
      "type": "object",
      "required": [
        "code",
        "name",
        "iso2",
        "iso3",
        "reference_mapped"
      ],
      "properties": {
        "code": {
          "$ref": "#/$defs/positive"
        },
        "name": {
          "type": [
            "string",
            "null"
          ]
        },
        "iso2": {
          "type": [
            "string",
            "null"
          ]
        },
        "iso3": {
          "type": [
            "string",
            "null"
          ]
        },
        "reference_mapped": {
          "const": true
        }
      },
      "additionalProperties": false
    },
    "coverage": {
      "type": "object",
      "required": [
        "complete_global_coverage",
        "source",
        "limitation",
        "absence_meaning",
        "trade_value_unit",
        "quantity_unit",
        "hs_revision"
      ],
      "properties": {
        "complete_global_coverage": {
          "const": false
        },
        "source": {
          "type": "string",
          "minLength": 1
        },
        "limitation": {
          "type": "string",
          "minLength": 1
        },
        "absence_meaning": {
          "type": "string",
          "minLength": 1
        },
        "trade_value_unit": {
          "type": [
            "string",
            "null"
          ]
        },
        "quantity_unit": {
          "type": [
            "string",
            "null"
          ]
        },
        "hs_revision": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "metadata": {
      "type": "object",
      "required": [
        "schema_version",
        "dataset_version",
        "year",
        "eligibility",
        "record_grain",
        "eligible_records",
        "unique_composite_keys",
        "observed_self_links",
        "observed_exporters",
        "observed_importers",
        "observed_products",
        "observed_routes",
        "reciprocal_pairs",
        "coverage"
      ],
      "properties": {
        "schema_version": {
          "const": "1.0"
        },
        "dataset_version": {
          "$ref": "#/$defs/version"
        },
        "year": {
          "$ref": "#/$defs/positive"
        },
        "eligibility": {
          "type": "string",
          "minLength": 1
        },
        "record_grain": {
          "const": [
            "year",
            "exporter_code",
            "importer_code",
            "product_code"
          ]
        },
        "eligible_records": {
          "$ref": "#/$defs/count"
        },
        "unique_composite_keys": {
          "$ref": "#/$defs/count"
        },
        "observed_self_links": {
          "$ref": "#/$defs/count"
        },
        "observed_exporters": {
          "$ref": "#/$defs/count"
        },
        "observed_importers": {
          "$ref": "#/$defs/count"
        },
        "observed_products": {
          "$ref": "#/$defs/count"
        },
        "observed_routes": {
          "$ref": "#/$defs/count"
        },
        "reciprocal_pairs": {
          "$ref": "#/$defs/count"
        },
        "coverage": {
          "$ref": "#/$defs/coverage"
        }
      },
      "additionalProperties": false
    }
  }
}
