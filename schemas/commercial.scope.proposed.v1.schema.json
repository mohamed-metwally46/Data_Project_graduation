{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Globiq proposed scope commercial configuration v1.0.0",
  "type": "object",
  "required": [
    "version",
    "is_synthetic",
    "is_planning_artifact",
    "backend_importable",
    "full_marketplace_release",
    "listing_generation_authorized",
    "exact_approval",
    "strategy",
    "products",
    "unit_registry",
    "decimal_policy",
    "price_variation",
    "master_seed",
    "hard_budgets",
    "fulfillment"
  ],
  "additionalProperties": false,
  "properties": {
    "version": {
      "const": "1.0.0"
    },
    "is_synthetic": {
      "const": true
    },
    "is_planning_artifact": {
      "const": true
    },
    "backend_importable": {
      "const": false
    },
    "full_marketplace_release": {
      "const": false
    },
    "listing_generation_authorized": {
      "const": false
    },
    "exact_approval": {
      "const": false
    },
    "strategy": {
      "const": "adaptive_scope_option_d"
    },
    "products": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^(?:[0-9]{6}|9999AA)$"
      },
      "minProperties": 300,
      "maxProperties": 300,
      "additionalProperties": {
        "type": "object",
        "required": [
          "reference_description",
          "suitability",
          "disposition",
          "specification",
          "resolution",
          "decision_group",
          "commercial_group",
          "commercial_terms",
          "exact_approval"
        ],
        "additionalProperties": false,
        "properties": {
          "reference_description": {
            "type": "string",
            "minLength": 1
          },
          "suitability": {
            "enum": [
              "restricted_offline_qa",
              "marketplace_allowed",
              "review_required"
            ]
          },
          "disposition": {
            "enum": [
              "existing_proposal",
              "new_proposal",
              "unresolved_excluded",
              "offline_only"
            ]
          },
          "specification": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "specification_key": {
                    "type": "string",
                    "minLength": 1
                  },
                  "specification_version": {
                    "const": "1.0.0"
                  },
                  "display_name": {
                    "type": "string",
                    "minLength": 1
                  },
                  "physical_form": {
                    "enum": [
                      "area_material",
                      "bulk_net_mass",
                      "length_material",
                      "liquid",
                      "retail_pack",
                      "saleable_pair",
                      "solid_volume",
                      "standalone_device",
                      "standalone_item",
                      "tool_assortment"
                    ]
                  },
                  "saleable_unit_definition": {
                    "type": "string",
                    "minLength": 1
                  },
                  "canonical_uom": {
                    "type": "string",
                    "pattern": "^[A-Z][A-Z0-9]{0,8}$"
                  },
                  "allowed_uoms": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "pattern": "^[A-Z][A-Z0-9]{0,8}$"
                    },
                    "minItems": 1,
                    "uniqueItems": true
                  },
                  "excluded_forms": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1
                    },
                    "minItems": 0
                  },
                  "measurement_assumptions": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1
                    },
                    "minItems": 1
                  },
                  "is_synthetic": {
                    "const": true
                  }
                },
                "required": [
                  "specification_key",
                  "specification_version",
                  "display_name",
                  "physical_form",
                  "saleable_unit_definition",
                  "canonical_uom",
                  "allowed_uoms",
                  "excluded_forms",
                  "measurement_assumptions",
                  "is_synthetic"
                ],
                "additionalProperties": false
              },
              {
                "type": "null"
              }
            ]
          },
          "resolution": {
            "type": "string",
            "minLength": 1
          },
          "decision_group": {
            "type": "string",
            "minLength": 1
          },
          "commercial_group": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "null"
              }
            ]
          },
          "commercial_terms": {
            "anyOf": [
              {
                "type": "object",
                "required": [
                  "is_synthetic",
                  "is_planning_artifact",
                  "backend_importable",
                  "full_marketplace_release",
                  "planning_only",
                  "product_code",
                  "reference_description",
                  "provisional_group",
                  "anchor_exporter",
                  "anchor_importer",
                  "commercial_group",
                  "group_assignment",
                  "review_notes",
                  "measurement_unit",
                  "permitted_units",
                  "quantity_precision",
                  "reference_price",
                  "reference_price_source",
                  "price_bounds",
                  "price_variation",
                  "initial_price_domains",
                  "currency",
                  "price_basis_quantity",
                  "price_basis_unit",
                  "quoted_price_precision",
                  "stock_bounds",
                  "moq_bounds",
                  "quantity_increment",
                  "rfq_quantity_bounds",
                  "maximum_order_quantity",
                  "configuration_version",
                  "override_fields",
                  "commercial_provenance"
                ],
                "properties": {
                  "is_synthetic": {
                    "const": true
                  },
                  "is_planning_artifact": {
                    "const": true
                  },
                  "backend_importable": {
                    "const": false
                  },
                  "full_marketplace_release": {
                    "const": false
                  },
                  "planning_only": {
                    "const": true
                  },
                  "product_code": {
                    "type": "string",
                    "minLength": 1,
                    "pattern": "^([0-9]{6}|9999AA)$"
                  },
                  "reference_description": {
                    "type": "string",
                    "minLength": 1
                  },
                  "provisional_group": {
                    "type": "string",
                    "minLength": 1
                  },
                  "anchor_exporter": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "anchor_importer": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "commercial_group": {
                    "type": "string",
                    "minLength": 1
                  },
                  "group_assignment": {
                    "type": "string",
                    "minLength": 1
                  },
                  "review_notes": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1
                    },
                    "minItems": 0
                  },
                  "measurement_unit": {
                    "type": "string",
                    "minLength": 1,
                    "pattern": "^[A-Z][A-Z0-9]{0,8}$"
                  },
                  "permitted_units": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1,
                      "pattern": "^[A-Z][A-Z0-9]{0,8}$"
                    },
                    "minItems": 1
                  },
                  "quantity_precision": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 8
                  },
                  "reference_price": {
                    "type": "string",
                    "minLength": 1,
                    "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]+)?$"
                  },
                  "reference_price_source": {
                    "type": "string",
                    "minLength": 1
                  },
                  "price_bounds": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1,
                      "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]+)?$"
                    },
                    "minItems": 2,
                    "maxItems": 2
                  },
                  "price_variation": {
                    "type": "object",
                    "required": [
                      "listing",
                      "rfq",
                      "offer"
                    ],
                    "properties": {
                      "listing": {
                        "type": "array",
                        "items": {
                          "type": "string",
                          "minLength": 1,
                          "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]+)?$"
                        },
                        "minItems": 2,
                        "maxItems": 2
                      },
                      "rfq": {
                        "type": "array",
                        "items": {
                          "type": "string",
                          "minLength": 1,
                          "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]+)?$"
                        },
                        "minItems": 2,
                        "maxItems": 2
                      },
                      "offer": {
                        "type": "array",
                        "items": {
                          "type": "string",
                          "minLength": 1,
                          "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]+)?$"
                        },
                        "minItems": 2,
                        "maxItems": 2
                      }
                    },
                    "additionalProperties": false
                  },
                  "initial_price_domains": {
                    "type": "object",
                    "required": [
                      "listing",
                      "rfq"
                    ],
                    "properties": {
                      "listing": {
                        "type": "array",
                        "items": {
                          "type": "string",
                          "minLength": 1,
                          "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]+)?$"
                        },
                        "minItems": 2,
                        "maxItems": 2
                      },
                      "rfq": {
                        "type": "array",
                        "items": {
                          "type": "string",
                          "minLength": 1,
                          "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]+)?$"
                        },
                        "minItems": 2,
                        "maxItems": 2
                      }
                    },
                    "additionalProperties": false
                  },
                  "currency": {
                    "type": "string",
                    "minLength": 1,
                    "pattern": "^[A-Z]{3}$"
                  },
                  "price_basis_quantity": {
                    "type": "string",
                    "minLength": 1,
                    "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]+)?$"
                  },
                  "price_basis_unit": {
                    "type": "string",
                    "minLength": 1,
                    "pattern": "^[A-Z][A-Z0-9]{0,8}$"
                  },
                  "quoted_price_precision": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 8
                  },
                  "stock_bounds": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1,
                      "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]+)?$"
                    },
                    "minItems": 2,
                    "maxItems": 2
                  },
                  "moq_bounds": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1,
                      "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]+)?$"
                    },
                    "minItems": 2,
                    "maxItems": 2
                  },
                  "quantity_increment": {
                    "type": "string",
                    "minLength": 1,
                    "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]+)?$"
                  },
                  "rfq_quantity_bounds": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1,
                      "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]+)?$"
                    },
                    "minItems": 2,
                    "maxItems": 2
                  },
                  "maximum_order_quantity": {
                    "anyOf": [
                      {
                        "type": "string",
                        "minLength": 1,
                        "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]+)?$"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "configuration_version": {
                    "const": "1.0.0"
                  },
                  "override_fields": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1
                    },
                    "minItems": 0
                  },
                  "commercial_provenance": {
                    "const": "proposed_synthetic_parameters"
                  }
                },
                "additionalProperties": false
              },
              {
                "type": "null"
              }
            ]
          },
          "exact_approval": {
            "const": false
          }
        }
      }
    },
    "unit_registry": {
      "type": "object"
    },
    "decimal_policy": {
      "type": "object"
    },
    "price_variation": {
      "type": "object"
    },
    "master_seed": {
      "const": 42
    },
    "hard_budgets": {
      "const": false
    },
    "fulfillment": {
      "const": "full_independent_no_reservation"
    }
  }
}
